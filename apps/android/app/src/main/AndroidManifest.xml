<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Stage 0/1 of ARCHITECTURE_2.md §7 — SMS is classified on-device before
         anything is queued for upload; RECEIVE_SMS is the runtime permission
         requested from the M7 onboarding screen, never assumed at install. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- RECEIVE_SMS/READ_SMS otherwise imply this feature as required, which
         excludes every device with no cellular radio (tablets, Chromebooks,
         Wear/TV) from the Play listing entirely. The app already falls back
         to manual entry when SMS access isn't available (see SettingsScreen's
         "you chose to add expenses by hand instead" copy), so it's optional. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".CostiqApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Costiq"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Costiq"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Disable WorkManager's default auto-init ContentProvider so it
             doesn't initialize WorkManager with a plain reflection-based
             factory before CostiqApplication.onCreate() wires up
             HiltWorkerFactory (Configuration.Provider) — otherwise every
             @HiltWorker permanently falls back to no-arg reflection and
             fails with NoSuchMethodException. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- High priority so Costiq's Stage-0 classifier sees the message
             promptly; it never aborts the broadcast, so other SMS apps are
             unaffected (§7 — Costiq only reads and classifies, never blocks). -->
        <receiver
            android:name=".data.sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
